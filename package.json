{
  "name": "alika-school-portal",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev": "tsx backend/server.ts",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build": "npm run build:frontend && npm run build:backend && rm -rf dist && cp -r frontend/dist ./dist",
    "start": "node backend/dist/server.cjs",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:push": "npm run db:push --workspace=backend",
    "lint:frontend": "npm run lint --workspace=frontend",
    "lint:backend": "npm run lint --workspace=backend",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "test:backend": "npm run test --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "test": "npm run test:backend && npm run test:frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "tsx": "^4.21.0",
    "vite": "^6.2.3",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.11",
    "ci": "^2.3.0",
    "cors": "^2.8.6"
  }
}
