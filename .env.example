# =============================================================================
# Alika Medical Training College & Medical Center — Environment Configuration
# Copy this file to .env and customize values for your deployment environment.
# DO NOT commit real secrets or production credentials to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# -----------------------------------------------------------------------------
NODE_ENV="production"
PORT="3000"

# Public application base URL (used for links, password reset callbacks, redirects)
APP_URL="https://portal.alikamedical.co.ke"
APP_BASE_URL="https://portal.alikamedical.co.ke"

# Allowed CORS origins (comma-separated list of origins)
CORS_ORIGINS="https://portal.alikamedical.co.ke,https://alikamedical.co.ke"
FRONTEND_URL="https://portal.alikamedical.co.ke"

# Optional path overrides (defaults work automatically for standard / Docker layouts)
# FRONTEND_DIST_PATH="/app/frontend/dist"
# UPLOAD_DIR="/app/uploads"
# STUDENT_DASHBOARD_QUERY_TIMEOUT_MS="4000"

# -----------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
# 64-character hexadecimal or base64 cryptographic secret for signing JWT tokens
# Generate with: openssl rand -hex 32
JWT_SECRET="replace_with_a_secure_random_64_char_hex_secret_key_here"

# Access & Refresh token lifespans (e.g. 15m, 1h, 7d, 30d)
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Initial root administration passcode & default fallback role passwords
# (Admins will be prompted to establish their permanent password on initial setup)
ADMIN_PASSCODE="replace_with_secure_admin_passcode"
DEFAULT_ADMIN_PASSWORD="replace_with_secure_admin_password"
DEFAULT_STUDENT_PASSWORD="replace_with_default_student_password"
DEFAULT_LECTURER_PASSWORD="replace_with_default_lecturer_password"
DEFAULT_ACCOUNTANT_PASSWORD="replace_with_default_accountant_password"
DEFAULT_LIBRARIAN_PASSWORD="replace_with_default_librarian_password"

# -----------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (POSTGRESQL / DRIZZLE ORM)
# -----------------------------------------------------------------------------
# Option A: Standard PostgreSQL Connection String URI (Supabase, Neon, AWS RDS, etc.)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL="postgresql://postgres:your_db_password@localhost:5432/alika_school_portal"

# Option B: Discrete Parameters (e.g. Cloud SQL, Docker Compose, or Local PG)
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_DB_NAME="alika_school_portal"
SQL_USER="postgres"
SQL_PASSWORD="your_secure_db_password"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="your_secure_db_password"

# PostgreSQL connection pool tuning
DB_POOL_MAX="10"
DB_CONNECTION_TIMEOUT_MS="30000"
DB_IDLE_TIMEOUT_MS="30000"
DB_MAX_LIFETIME_SECONDS="300"

# -----------------------------------------------------------------------------
# 4. SUPABASE INTEGRATION (Optional - if using Supabase client directly)
# -----------------------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-or-service-role-key"

# -----------------------------------------------------------------------------
# 5. EMAIL DELIVERY & PASSWORD RESET (RESEND SERVICE)
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key_here"
PASSWORD_RESET_FROM="Alika Medical Security <info@alikamedical.co.ke>"
RESEND_FROM="Alika Medical Security <info@alikamedical.co.ke>"

# -----------------------------------------------------------------------------
# 6. AI ASSIST INTEGRATION (GEMINI API)
# -----------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"
