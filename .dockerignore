uploads/doc-*
backend/uploads/doc-*

# System, temporary, and editor files
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
.system_generated
.agents
.claude
.codex
orthoc
tmp
coverage
