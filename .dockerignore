# Version control
.git
.gitignore

# Dependencies
node_modules
*/node_modules

# Build outputs
dist
build
frontend/dist
backend/dist

# Environment variables & secrets
.env
.env.*
!.env.example

# Sensitive uploaded files & private applicant documents
uploads/applications/*
